DirectoryIndex index.html
Options -Indexes -MultiViews
ErrorDocument 404 /404/index.html

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Never rewrite real assets or the Decap entry point.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  # Run before the directory check so deep links also work without a trailing slash.
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
  # Existing directories retain normal DirectoryIndex handling (including /admin/).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
   # Only new extensionless article URLs use the client shell; assets retain real 404s.
   RewriteRule ^ratgeber/[^/.]+/?$ _shell/index.html [L]
  # No catch-all to index.html: unknown pages and missing assets stay HTTP 404.
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>